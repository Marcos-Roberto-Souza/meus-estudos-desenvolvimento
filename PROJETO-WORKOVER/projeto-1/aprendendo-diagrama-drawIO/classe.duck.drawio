        <mxCell id="8UvIAgLWE496YU5o2yjA-37" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=16;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;A Classe Duck implementa o comportamento de vôo padrão que é herdado por todo xxxDuck() que for seu filho. Se algum xxxDuck tiver um comportamento de vôo diferente, ele precisa sobreescrever o método fly(). O mesmo é válido para o comportamento de quack(), display e eat()&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="270" x="420" y="40" as="geometry" />
        </mxCell>
        <mxCell id="8UvIAgLWE496YU5o2yjA-38" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FF9999;strokeColor=#b85450;fillStyle=solid;fontSize=23;direction=west;gradientDirection=north;shadow=1;size=0;pointerEvents=1;align=left;labelBackgroundColor=none;labelBorderColor=none;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;public void fly(){&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;System.out.println(&quot;Meu vôo é simples!&quot;);&lt;br&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;}&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="370" x="690" y="40" as="geometry" />
        </mxCell>
        <mxCell id="8UvIAgLWE496YU5o2yjA-39" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#FF9999;strokeColor=#b85450;fillStyle=solid;fontSize=14;direction=west;gradientDirection=north;shadow=1;size=0;pointerEvents=1;align=left;labelBorderColor=light-dark(#decece, #ededed);" value="public void quack(){&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;System.out.println(&quot;Meu quack é simples e real &quot;);&lt;br&gt;}" vertex="1">
